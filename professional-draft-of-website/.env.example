# ---------------------------------------------------------------------------
# GTRE website environment variables
#
# The prototype runs with NO env vars (it uses a localStorage mock store).
# These become required only when you wire the real Supabase backend — see
# SETUP.md. Copy this file to `.env.local` and fill in the values from your
# Supabase project (Project Settings → API).
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — NEVER expose this to the browser. Used by admin/server actions
# (e.g. approving accounts, sending approval emails).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Flip to "supabase" once the backend is wired to switch off the mock store.
# Anything else (or unset) keeps the localStorage prototype adapter.
NEXT_PUBLIC_DATA_BACKEND=mock
