# Production Supabase config (used by `next build` — e.g. on Vercel).
#
# Every value here is NEXT_PUBLIC_* and safe to commit: the anon key is designed
# to ship in the browser bundle, and Row-Level Security is what protects data.
# The service-role key is NOT here and is never committed.
#
# To override these on Vercel, add the same variable names in
# Project → Settings → Environment Variables — dashboard values win over this file.

NEXT_PUBLIC_SUPABASE_URL=https://udkcnjvzommusxfpyqgo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVka2NuanZ6b21tdXN4ZnB5cWdvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY0MDU4NDYsImV4cCI6MjEwMTk4MTg0Nn0.W1cw6fpSoot0p1Bla5WsqLAkNfJ43MpN7JzUQ0LnkC8

# DEMO MODE: the site runs on the built-in demo data (localStorage) so logins
# work instantly with no Supabase setup. Demo logins:
#   eaziz3@gatech.edu / gtre2026   (admin)
